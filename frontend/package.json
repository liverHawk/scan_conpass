    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "fast-check": "^4.10.2",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
